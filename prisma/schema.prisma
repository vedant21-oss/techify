generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  LAPTOP
  PHONE
}

/// A purchasable device configuration. Specs are stored in two forms:
/// pre-normalized 0–100 tiers (cpu/gpu/camera/display) curated from benchmark
/// standings, and raw physical values the scoring engine normalizes itself.
model Device {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    Category
  brand       String
  name        String
  variant     String
  /// Price in whole rupees.
  price       Int
  releaseYear Int

  cpuName     String
  gpuName     String?
  displayName String
  cameraName  String?

  cpuScore     Int
  gpuScore     Int?
  cameraScore  Int?
  displayScore Int

  ramGb           Int
  storageGb       Int
  /// Watt-hours for laptops, mAh for phones. Null when the listing doesn't publish it.
  batteryCapacity Int?
  chargingWatts   Int?
  weightGrams     Int?

  /// When the price and specs were last checked, and where.
  priceCheckedOn DateTime @default(now())
  priceSource    String   @default("")

  /// Overrides the marketplace search text when brand + name is ambiguous.
  searchQuery String?

  alerts      PriceAlert[]
  pricePoints PricePoint[]
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, price])
}

/// "Email me when this device drops to ₹X." Checked by the daily price-alert job.
model PriceAlert {
  id            String    @id @default(cuid())
  email         String
  deviceId      String
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  targetPrice   Int
  priceAtSignup Int
  /// Secret used in the one-click unsubscribe link.
  token         String    @unique @default(cuid())
  createdAt     DateTime  @default(now())
  /// Set once the alert email has been sent; triggered alerts stop counting toward limits.
  triggeredAt   DateTime?

  @@unique([email, deviceId])
  @@index([triggeredAt])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

/// One Razorpay order for Techify Pro. A PAID row makes its email a Pro member.
model ProPayment {
  id                String        @id @default(cuid())
  email             String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amountPaise       Int
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  paidAt            DateTime?

  @@index([email, status])
}

/// One recorded price. Written whenever a device's price changes (seed or admin).
model PricePoint {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  price      Int
  source     String   @default("")
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
}

/// A device announced or expected in India but not on sale yet.
model UpcomingDevice {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  category       Category
  brand          String
  name           String
  expectedPrice  Int?
  expectedLaunch String
  summary        String
  sourceUrl      String?
  /// Set when it launches and joins the catalogue; subscribers are emailed once.
  launchedSlug   String?
  launchedAt     DateTime?
  createdAt      DateTime               @default(now())
  subscriptions  UpcomingSubscription[]
}

model UpcomingSubscription {
  id         String         @id @default(cuid())
  email      String
  upcomingId String
  upcoming   UpcomingDevice @relation(fields: [upcomingId], references: [id], onDelete: Cascade)
  token      String         @unique @default(cuid())
  createdAt  DateTime       @default(now())
  notifiedAt DateTime?

  @@unique([email, upcomingId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An owner's review. Shown only after an admin approves it.
model Review {
  id          String       @id @default(cuid())
  deviceId    String
  device      Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name        String
  email       String
  rating      Int
  title       String
  body        String
  usedFor     String
  ownedMonths Int
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([email, deviceId])
  @@index([deviceId, status])
}
