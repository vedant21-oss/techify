generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  LAPTOP
  PHONE
}

/// A purchasable device configuration. Specs are stored in two forms:
/// pre-normalized 0–100 tiers (cpu/gpu/camera/display) curated from benchmark
/// standings, and raw physical values the scoring engine normalizes itself.
model Device {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    Category
  brand       String
  name        String
  variant     String
  /// Price in whole rupees.
  price       Int
  releaseYear Int

  cpuName     String
  gpuName     String?
  displayName String
  cameraName  String?

  cpuScore     Int
  gpuScore     Int?
  cameraScore  Int?
  displayScore Int

  ramGb           Int
  storageGb       Int
  /// Watt-hours for laptops, mAh for phones. Null when the listing doesn't publish it.
  batteryCapacity Int?
  chargingWatts   Int?
  weightGrams     Int?

  /// When the price and specs were last checked, and where.
  priceCheckedOn DateTime @default(now())
  priceSource    String   @default("")

  /// Overrides the marketplace search text when brand + name is ambiguous.
  searchQuery String?

  alerts      PriceAlert[]
  pricePoints PricePoint[]
  reviews     Review[]
  listEntries ListEntry[]
  offers      BankOffer[]
  ads         Ad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, price])
}

enum CardType {
  ANY
  CREDIT
  DEBIT
}

enum OfferKind {
  FLAT
  PERCENT
}

/// An instant card discount at one store, entered from the admin dashboard. One
/// offer applies per purchase: the biggest one the buyer's card qualifies for.
model BankOffer {
  id              String    @id @default(cuid())
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Bank id from BANKS in src/lib/features/offers.ts.
  bank            String
  cardType        CardType  @default(ANY)
  kind            OfferKind
  /// Rupees for FLAT, percent for PERCENT. Zero for an offer that is only no-cost EMI.
  amount          Int
  /// Cap on a PERCENT discount, in rupees.
  maxDiscount     Int?
  /// The discount only applies when the purchase is converted to EMI.
  emiOnly         Boolean   @default(false)
  /// Longest no-cost EMI tenure the offer allows, in months.
  noCostEmiMonths Int?
  store           String
  validUntil      DateTime?
  createdAt       DateTime  @default(now())

  @@index([deviceId])
}

/// "Email me when this device drops to ₹X." Checked by the daily price-alert job.
model PriceAlert {
  id            String    @id @default(cuid())
  email         String
  deviceId      String
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  targetPrice   Int
  priceAtSignup Int
  /// Secret used in the one-click unsubscribe link.
  token         String    @unique @default(cuid())
  createdAt     DateTime  @default(now())
  /// Set once the alert email has been sent; triggered alerts stop counting toward limits.
  triggeredAt   DateTime?

  @@unique([email, deviceId])
  @@index([triggeredAt])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

/// One Razorpay order for Techify Pro. A PAID row makes its email a Pro member.
model ProPayment {
  id                String        @id @default(cuid())
  email             String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amountPaise       Int
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
  /// Set when the buyer was logged in, so Pro follows the account.
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([userId, status])
}

/// One recorded price. Written whenever a device's price changes (seed or admin).
model PricePoint {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  price      Int
  source     String   @default("")
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
}

/// A device announced or expected in India but not on sale yet.
model UpcomingDevice {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  category       Category
  brand          String
  name           String
  expectedPrice  Int?
  expectedLaunch String
  summary        String
  sourceUrl      String?
  /// Set when it launches and joins the catalogue; subscribers are emailed once.
  launchedSlug   String?
  launchedAt     DateTime?
  createdAt      DateTime               @default(now())
  subscriptions  UpcomingSubscription[]
}

model UpcomingSubscription {
  id         String         @id @default(cuid())
  email      String
  upcomingId String
  upcoming   UpcomingDevice @relation(fields: [upcomingId], references: [id], onDelete: Cascade)
  token      String         @unique @default(cuid())
  createdAt  DateTime       @default(now())
  notifiedAt DateTime?

  @@unique([email, upcomingId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An owner's review. Shown only after an admin approves it.
model Review {
  id          String       @id @default(cuid())
  deviceId    String
  device      Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name        String
  email       String
  rating      Int
  title       String
  body        String
  usedFor     String
  ownedMonths Int
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([email, deviceId])
  @@index([deviceId, status])
}

/// A Techify account. Alerts, launch emails and Pro purchases made with the same
/// email only attach to the account once that email is verified.
model User {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String
  /// scrypt hash: `scrypt$N$r$p$salt$hash`.
  passwordHash    String
  emailVerifiedAt DateTime?
  failedLogins    Int         @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime    @default(now())
  sessions        Session[]
  tokens          AuthToken[]
  listEntries     ListEntry[]
  payments        ProPayment[]
  reviews         Review[]
}

/// A logged-in browser. Only a SHA-256 of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use link token for email verification or password reset (hash only).
model AuthToken {
  id        String        @id @default(cuid())
  kind      AuthTokenKind
  tokenHash String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

enum ListKind {
  SAVED
  RECENT
}

/// A device on an account's saved list or recently viewed history.
model ListEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind      ListKind
  /// Newest first when sorted descending.
  addedAt   DateTime @default(now())

  @@unique([userId, kind, deviceId])
  @@index([userId, kind, addedAt])
}

enum AdPlacement {
  HOME
  RESULTS
  DEVICE
}

/// A sponsored slot, entered from the admin dashboard. Always shown labelled as an
/// ad, and never read by the scoring engine, so it can't move a ranking.
model Ad {
  id          String        @id @default(cuid())
  /// Who paid for it, shown next to the "Ad" label.
  advertiser  String
  headline    String
  body        String
  cta         String
  /// Where the click goes: an https:// URL or a path on this site.
  url         String
  placements  AdPlacement[]
  /// Only on phone or laptop pages; null shows it on both.
  category    Category?
  /// Optional catalogue device; the ad then shows its live price.
  deviceId    String?
  device      Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// Relative share when several ads compete for one slot.
  weight      Int           @default(1)
  active      Boolean       @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  views       Int           @default(0)
  clicks      Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([active])
}
