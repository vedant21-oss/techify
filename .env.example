# Postgres connection string. For local development, run `npm run db:dev` and
# paste the TCP (postgres://) URL it prints. For production, use your hosted
# Postgres URL (Neon, Supabase, Prisma Postgres, …).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Optional: lets the "Just type it" search use Claude (claude-opus-5) to read the
# sentence. Without it, a built-in keyword parser handles the search instead.
# ANTHROPIC_API_KEY="sk-ant-..."
# Force the keyword parser even when a key is set:
# TECHIFY_QUERY_PARSER="rules"

# Price-drop alert emails via Resend (https://resend.com). Without these, alert
# emails are printed to the server log instead of sent.
# RESEND_API_KEY="re_..."
# ALERTS_FROM_EMAIL="Techify <alerts@yourdomain.com>"
# Public base URL used in email links.
# APP_URL="http://localhost:3000"
# Vercel Cron sends this as a Bearer token to /api/cron/price-alerts.
# CRON_SECRET="a-long-random-string"

# Techify Pro payments via Razorpay. Use test-mode keys while developing.
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# TECHIFY_PRO_PRICE_INR="99"

# Admin dashboard at /admin (prices, review moderation, upcoming launches).
# The dashboard stays locked until ADMIN_PASSWORD is set.
# ADMIN_PASSWORD="choose-a-long-password"
# Signs the admin session cookie. Falls back to ADMIN_PASSWORD if unset.
# ADMIN_SESSION_SECRET="a-different-long-random-string"

# Affiliate IDs added to store links. Without them, store links are plain searches
# and the footer says so.
# AMAZON_ASSOCIATE_TAG="yourtag-21"
# FLIPKART_AFFILIATE_ID="youraffid"
